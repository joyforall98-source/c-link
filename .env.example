# Vercel 대시보드 > Settings > Environment Variables 에 아래 이름으로 등록하세요.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY: Supabase 프로젝트 > Project Settings > API (service_role 키는 절대 공개하지 마세요)
# SESSION_SECRET: 아무도 모르는 긴 임의 문자열 (예: 64자). 바꾸면 모든 기기가 다시 코드를 입력해야 합니다.
# 내 컴퓨터에서 값 없이 실행하면 메모리에 임시 저장합니다 (껐다 켜면 사라짐).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
